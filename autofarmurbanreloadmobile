		espObjects[m] = nil
	end
end

local function isVisible(part)
	local myChar = localPlayer.Character
	if not myChar then return false end
	local p = RaycastParams.new()
	p.FilterType = Enum.RaycastFilterType.Exclude
	p.FilterDescendantsInstances = { myChar }
	p.IgnoreWater = true
	local o = camera.CFrame.Position
	local r = Workspace:Raycast(o, part.Position - o, p)
	if r then return r.Instance:IsDescendantOf(part.Parent) end
	return true
end

local function equipar()
	local myChar = localPlayer.Character
	if not myChar then return end
	local hum = myChar:FindFirstChildOfClass("Humanoid")
	local bp = localPlayer:FindFirstChild("Backpack")
	local t = bp and bp:FindFirstChildOfClass("Tool")
	if hum and t then pcall(function() hum:EquipTool(t) end) end
end

local function buscarBotonFuego()
	local n = 0
	for _, o in ipairs(playerGui:GetDescendants()) do
		n = n + 1
		if n > 2500 then break end
		if o:IsA("GuiButton") and o.Visible then
			local lower = string.lower(o.Name)
			for _, kw in ipairs(FIRE) do
				if string.find(lower, kw, 1, true) then
					fireButton = o
					log("boton fuego: " .. o.Name)
					return
				end
			end
		end
	end
end

local function tocar(btn)
	local ap, as = btn.AbsolutePosition, btn.AbsoluteSize
	pcall(function()
		VirtualInputManager:SendMouseButtonEvent(ap.X + as.X / 2, ap.Y + as.Y / 2, 1, true, game, 0)
		VirtualInputManager:SendMouseButtonEvent(ap.X + as.X / 2, ap.Y + as.Y / 2, 1, false, game, 0)
	end)
end

-- escaneo capado
local function escanear()
	local myChar = localPlayer.Character
	local root = myChar and myChar:FindFirstChild("HumanoidRootPart")
	if not root then return {} end
	local myPos = root.Position
	local out = {}
	local n = 0

	local function check(m)
		n = n + 1
		if n > CONFIG.scanCap then return end
		if m:IsA("Model") and m ~= myChar and not Players:GetPlayerFromCharacter(m) then
			local h = m:FindFirstChildOfClass("Humanoid")
			local p = m:FindFirstChild("Head") or m:FindFirstChild("UpperTorso")
			if h and h.Health > 0 and p then
				local d = (p.Position - myPos).Magnitude
				if d <= CONFIG.scanRange then
					out[#out + 1] = { part = p, dist = d }
				end
			end
		end
	end

	for _, o in ipairs(Workspace:GetChildren()) do
		if n > CONFIG.scanCap then break end
		check(o)
		if o:IsA("Folder") or o:IsA("Model") then
			for _, s in ipairs(o:GetChildren()) do
				if n > CONFIG.scanCap then break end
				check(s)
			end
		end
	end

	table.sort(out, function(a, b) return a.dist < b.dist end)
	return out
end

