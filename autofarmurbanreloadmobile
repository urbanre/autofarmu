local KW = {"cash", "money", "coins", "coin", "dinero", "balance", "bucks", "dollars"}

local function coincide(name)
	if not name then return false end
	local lower = string.lower(name)
	for _, kw in ipairs(KW) do
		if string.find(lower, kw, 1, true) then return true end
	end
	return false
end

local moneySource, lastMoney, sessionGain = nil, nil, 0

local function buscarFuente()
	for a in pairs(localPlayer:GetAttributes()) do
		if coincide(a) then return { kind = "attr", object = localPlayer, name = a } end
	end
	local ls = localPlayer:FindFirstChild("leaderstats")
	if ls then
		for _, o in ipairs(ls:GetDescendants()) do
			if o:IsA("ValueBase") and coincide(o.Name) then return { kind = "value", object = o } end
		end
	end
	local pg = localPlayer:FindFirstChild("PlayerGui")
	if pg then
		local n = 0
		for _, o in ipairs(pg:GetDescendants()) do
			n = n + 1
			if n > 4000 then break end
			if o:IsA("TextLabel") and coincide(o.Name) then return { kind = "gui", object = o } end
		end
	end
	return nil
end

local function leerDinero()
	if not moneySource then return nil end
	local o = moneySource.object
	if not o or (moneySource.kind ~= "attr" and not o.Parent) then
		moneySource = nil
		return nil
	end
	if moneySource.kind == "attr" then return tonumber(o:GetAttribute(moneySource.name)) end
	if moneySource.kind == "value" then return parseNumber(o.Value) end
	return parseNumber(o.Text)
end

