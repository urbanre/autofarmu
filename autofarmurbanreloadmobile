-- ==========================================
task.spawn(function()
	task.wait(CONFIG.warmup)
	log("planificador activo")

	local tEsp, tAct, tPrompt, tMoney, tScan, tFire, tRuntime, tBoton = 0,0,0,0,0,0,0,0
	local candidatos = {}

	while alive() do
		local ok, err = pcall(function()
			local now = os.clock()
			local myChar = localPlayer.Character
			local root = myChar and myChar:FindFirstChild("HumanoidRootPart")
			local hum = myChar and myChar:FindFirstChildOfClass("Humanoid")

			if now - tRuntime > 0.5 then
				tRuntime = now
				local total = math.floor(now - START)
				runtimeValue.Text = string.format("%02d:%02d:%02d",
					math.floor(total / 3600), math.floor((total % 3600) / 60), total % 60)
			end

			if now - tMoney > CONFIG.moneyInterval then
				tMoney = now
				if not moneySource and now - tScan > 6 then
					tScan = now
					moneySource = buscarFuente()
				end
				local v = leerDinero()
				if v then
					if lastMoney and v > lastMoney then sessionGain = sessionGain + (v - lastMoney) end
					lastMoney = v
					moneyValue.Text = "$" .. formatMoney(v)
					sessionValue.Text = "+$" .. formatMoney(sessionGain)
				else
					moneyValue.Text = "--"
				end
			end

			if CONFIG.useFireButton and not fireButton and now - tBoton > 5 then
				tBoton = now
				buscarBotonFuego()
			end

			if espEnabled and CONFIG.useHighlights and now - tEsp > CONFIG.espInterval then
				tEsp = now
				if root then
					local lista = escanear()
					local keep = {}
					for i = 1, math.min(#lista, CONFIG.espMax) do
						local m = lista[i].part.Parent
						keep[m] = true
						if not espObjects[m] then
							local hl = Instance.new("Highlight")
							hl.Adornee = m
							hl.FillColor = Color3.fromRGB(255, 60, 60)
							hl.FillTransparency = 0.65
							hl.OutlineColor = Color3.fromRGB(255, 255, 255)
							hl.DepthMode = Enum.HighlightDepthMode.AlwaysOnTop
							hl.Parent = espFolder
							espObjects[m] = hl
						end
					end
					for m, hl in pairs(espObjects) do
						if not keep[m] then
							pcall(function() hl:Destroy() end)
							espObjects[m] = nil
						end
					end
				end
			end

			if farmActive and root and hum and hum.Health > 0 then
				if not myChar:FindFirstChildOfClass("Tool") and now - tAct > 0.9 then
					equipar()
				end

				if now - tScan > CONFIG.scanInterval then
					tScan = now
					candidatos = escanear()
				end

				local elegido = nil
				local probados = 0
				for i = 1, #candidatos do
					if probados >= 3 then break end
					local c = candidatos[i]
					if c.part and c.part.Parent then
						probados = probados + 1
						if isVisible(c.part) then
							elegido = c.part
							break
						end
					end
				end

				targetPart = elegido

				if elegido then
					if now - tAct > CONFIG.activateInterval then
						tAct = now
						local tool = myChar:FindFirstChildOfClass("Tool")
						if tool then pcall(function() tool:Activate() end) end
					end
					if CONFIG.useFireButton and fireButton and fireButton.Parent and now - tFire > CONFIG.fireInterval then
						tFire = now
						tocar(fireButton)
					end
				end

				if CONFIG.usePrompts and now - tPrompt > CONFIG.promptInterval and fireproximityprompt then
					tPrompt = now
					local op = OverlapParams.new()
					op.FilterType = Enum.RaycastFilterType.Exclude
					op.FilterDescendantsInstances = { myChar }
					op.MaxParts = CONFIG.promptMaxParts
					local parts = Workspace:GetPartBoundsInRadius(root.Position, CONFIG.promptRadius, op)
					for _, p in ipairs(parts) do
						local pr = p:FindFirstChildOfClass("ProximityPrompt")
						if pr then pcall(function() fireproximityprompt(pr) end) end
					end
				end
			elseif not farmActive then
				targetPart = nil
			end
		end)
		if not ok then log("error: " .. tostring(err)) end
		task.wait(0.1)
	end
end)

if CONFIG.useAim then
	RunService:BindToRenderStep("UrbanAim", Enum.RenderPriority.Camera.Value + 1, function()
		if not farmActive or not targetPart or not targetPart.Parent then return end
		pcall(function()
			camera.CFrame = CFrame.lookAt(camera.CFrame.Position, targetPart.Position)
		end)
	end)
end

