local function parseNumber(t)
	if type(t) == "number" then return t end
	if type(t) ~= "string" then return nil end
	return tonumber((t:gsub("[^%d%.%-]", "")))
end

local function formatMoney(n)
	if n == nil then return "--" end
	local out = tostring(math.floor(n)):reverse():gsub("(%d%d%d)", "%1,")
	return out:reverse():gsub("^,", "")
end

local function draggable(frame, handle)
	local dragging, inicio, posBase
	handle.InputBegan:Connect(function(input)
		if input.UserInputType == Enum.UserInputType.Touch
			or input.UserInputType == Enum.UserInputType.MouseButton1 then
			dragging = true
			inicio = input.Position
			posBase = frame.Position
			input.Changed:Connect(function()
				if input.UserInputState == Enum.UserInputState.End then dragging = false end
			end)
		end
	end)
	handle.InputChanged:Connect(function(input)
		if dragging and (input.UserInputType == Enum.UserInputType.Touch
			or input.UserInputType == Enum.UserInputType.MouseMovement) then
			local d = input.Position - inicio
			frame.Position = UDim2.new(
				posBase.X.Scale, posBase.X.Offset + d.X,
				posBase.Y.Scale, posBase.Y.Offset + d.Y
			)
		end
	end)
end

